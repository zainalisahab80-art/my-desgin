# ───── Required ─────
# Supabase: Project Settings -> API. Use the public "anon" key only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public URL of the site (SEO, sitemap, emails, password-reset links). Use https://your-domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ───── Optional: shown only when filled in ─────
# Defaults in src/lib/site.ts: msburiro54@gmail.com / 03183624730 / 923183624730. Set these only to override.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
# Digits only with country code, e.g. 923001234567 (enables the floating WhatsApp button)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=

# ───── Online payments (leave empty until you connect a gateway, see docs/PAYMENTS.md) ─────
# Name of the provider registered in src/lib/payments/index.ts
PAYMENT_PROVIDER=
# Secrets used only on the server. NEVER prefix with NEXT_PUBLIC_ and never commit real values.
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
# Needed ONLY by the payment webhook route. Supabase -> Project Settings -> API -> service_role. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=
